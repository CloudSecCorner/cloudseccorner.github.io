  </div>

  <!-- Dynamic Application Mount Point -->
  <div id="azure-architecture-app" class="mt-8">
    <div class="flex items-center justify-center p-12 text-slate-500 dark:text-slate-400">
      <div class="flex flex-col items-center gap-3">
        <div class="h-10 w-10 animate-spin rounded-full border-4 border-blue-500 border-t-transparent"></div>
        <p class="font-medium">Loading 1,000+ Azure Architecture Best Practices with Obsidian Pele…</p>
      </div>
    </div>
  </div>

  <noscript>

<section class="kube-tools-hero relative overflow-hidden">
  <!-- Ambient Glow Behind Hero -->
  <div class="pointer-events-none absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-r from-blue-600/20 via-indigo-600/20 to-cyan-500/15 blur-3xl rounded-full" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-screen-xl px-4 py-14 sm:px-6 lg:px-10 lg:py-20">
    <div class="kube-tools-hero-copy">
      <!-- Feature Pills -->
      <div class="inline-flex flex-wrap items-center gap-2 px-3.5 py-1.5 mb-5 rounded-full text-xs font-semibold bg-blue-500/15 text-blue-200 border border-blue-500/30 shadow-sm backdrop-blur-sm">
        <span class="flex items-center gap-1.5 text-blue-300">
          <svg class="w-3.5 h-3.5 text-blue-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg>
          Powered by Obsidian Pele
        </span>
        <span class="opacity-40">•</span>
        <span class="flex items-center gap-1 text-cyan-300">
          <svg class="w-3 h-3 text-cyan-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Pod &amp; Kind-Level Defense
        </span>
        <span class="opacity-40">•</span>
        <span class="text-white font-mono">1,032 Verified Blueprints</span>
      </div>

      <h1 class="tracking-tight">1,000+ KSPM Kubernetes Architecture <br class="hidden sm:inline" /><span>with Pele, OPA &amp; Pod Hardening</span></h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed max-w-3xl">Explore in-depth Kubernetes Security Posture Management (KSPM) and pod-level defensive blueprints across each Kubernetes Kind. Every pattern features deep responsive vector SVG diagrams rendered with Obsidian Pele, paired with production Open Policy Agent (OPA Rego) admission controls and complete hardened Kubernetes manifests.</p>

      <div class="mt-8 flex flex-wrap gap-4 items-center">
        <a class="kube-contribute-primary inline-flex items-center gap-2 shadow-lg shadow-blue-500/20 bg-blue-600 hover:bg-blue-500 text-white" href="#architecture-catalog">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
          Browse 1,000+ KSPM Blueprints
        </a>
        <a class="kube-tools-star inline-flex items-center gap-2" href="https://github.com/obsidianmd/pele" target="_blank" rel="noreferrer">
          <span aria-hidden="true" class="text-amber-400">★</span>
          <strong>Obsidian Pele</strong>
          <small>Lightning-Fast Mermaid Renderer ↗</small>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Stats Highlight Grid with Glassmorphism -->
<section class="border-y border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#10141d]">
  <div class="mx-auto max-w-screen-xl px-4 py-8 sm:px-6 lg:px-10">
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="p-5 rounded-2xl bg-white dark:bg-white/[0.03] shadow-sm border border-slate-200/80 dark:border-white/10 hover:border-blue-500/30 transition text-center sm:text-left">
        <div class="flex items-center justify-center sm:justify-start gap-2 mb-2">
          <span class="h-2 w-2 rounded-full bg-blue-500 animate-pulse"></span>
          <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Topologies</span>
        </div>
        <strong class="block text-3xl font-extrabold text-slate-900 dark:text-white">1,032</strong>
        <span class="text-xs text-slate-500 dark:text-slate-400 mt-1 block">Vector Pele SVGs</span>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-white/[0.03] shadow-sm border border-slate-200/80 dark:border-white/10 hover:border-cyan-500/30 transition text-center sm:text-left">
        <div class="flex items-center justify-center sm:justify-start gap-2 mb-2">
          <span class="h-2 w-2 rounded-full bg-cyan-500"></span>
          <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">K8s Kinds &amp; Domains</span>
        </div>
        <strong class="block text-3xl font-extrabold text-slate-900 dark:text-white">24 Kinds</strong>
        <span class="text-xs text-slate-500 dark:text-slate-400 mt-1 block">Pod &amp; Kind-Level Icons</span>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-white/[0.03] shadow-sm border border-slate-200/80 dark:border-white/10 hover:border-rose-500/30 transition text-center sm:text-left">
        <div class="flex items-center justify-center sm:justify-start gap-2 mb-2">
          <span class="h-2 w-2 rounded-full bg-rose-500"></span>
          <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Admission Guardrails</span>
        </div>
        <strong class="block text-3xl font-extrabold text-slate-900 dark:text-white">1,032</strong>
        <span class="text-xs text-slate-500 dark:text-slate-400 mt-1 block">OPA Rego Rules</span>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-white/[0.03] shadow-sm border border-slate-200/80 dark:border-white/10 hover:border-emerald-500/30 transition text-center sm:text-left">
        <div class="flex items-center justify-center sm:justify-start gap-2 mb-2">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Manifests</span>
        </div>
        <strong class="block text-3xl font-extrabold text-slate-900 dark:text-white">1,032</strong>
        <span class="text-xs text-slate-500 dark:text-slate-400 mt-1 block">Hardened K8s YAML</span>
      </div>
    </div>
  </div>
</section>

<!-- Interactive Explorer Section -->
<section id="architecture-catalog" class="mx-auto max-w-screen-xl px-4 py-12 sm:px-6 lg:px-10 lg:py-16">
  <div class="kube-tools-directory-heading">
    <div>
      <p class="kube-label">KSPM Architecture Catalog</p>
      <h2>Search, Filter &amp; Inspect Kubernetes Kind-Level Blueprints</h2>
    </div>
    <p>Filter by Kubernetes Kind, Pod Security Standards (PSA) level, Well-Architected pillar, or severity. Inspect the Obsidian Pele SVG architecture diagram, review and copy the OPA Rego admission policy to guard your cluster, or grab the hardened Kubernetes YAML manifest.</p>
  </div>

  <!-- Dynamic Application Mount Point -->
  <div id="kspm-architecture-app" class="mt-8">
    <div class="flex items-center justify-center p-12 text-slate-500 dark:text-slate-400">
      <div class="flex flex-col items-center gap-3">
        <div class="h-10 w-10 animate-spin rounded-full border-4 border-blue-500 border-t-transparent"></div>
        <p class="font-medium">Loading 1,000+ KSPM Kubernetes Architecture Best Practices with Obsidian Pele…</p>
      </div>
    </div>
  </div>

  <noscript>
    <div class="kube-tool-empty py-12 text-center">
      <h2>Interactive Architecture Catalog Requires JavaScript</h2>
      <p>Please enable JavaScript to view and filter the interactive Pele-rendered architecture diagrams, OPA Rego rules, and Kubernetes manifests, or download the raw dataset at <a href="/data/kspm-best-practices.json" target="_blank" class="text-blue-400 underline">/data/kspm-best-practices.json</a>.</p>
    </div>
  </noscript>
</section>

<!-- Include Pele and Client Controller -->
<script :if={!CloudSecurityCorner.Frontend.enabled?()} src="/assets/pele.global.js"></script>
<script :if={!CloudSecurityCorner.Frontend.enabled?()} defer src="/assets/kspm-architectures.js"></script>

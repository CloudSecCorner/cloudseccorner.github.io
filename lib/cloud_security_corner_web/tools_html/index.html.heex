<section class="kube-tools-hero">
  <div class="mx-auto max-w-screen-xl px-4 py-14 sm:px-6 lg:px-10 lg:py-20">
    <div class="kube-tools-hero-copy">
      <p class="kube-label">Security &amp; Agentic Ecosystem Directory</p>
      <h1>Find the tools that help teams <span>secure cloud and AI agents.</span></h1>
      <p>Search CloudSecCorner’s curated collection of 37,000+ projects across AI agent security, cloud defense, identity, runtime monitoring, and governance.</p>
      <a class="kube-tools-star" href="https://github.com/CloudSecCorner/cloudseccorner.github.io" target="_blank" rel="noreferrer">
        <span aria-hidden="true">★</span><strong id="kube-github-stars">GitHub stars</strong><small>Star CloudSecCorner on GitHub ↗</small>
      </a>
    </div>
  </div>
</section>

<section class="mx-auto max-w-screen-xl px-4 py-12 sm:px-6 lg:px-10 lg:py-16">
  <div class="kube-tools-directory-heading">
    <div>
      <p class="kube-label">Explore the directory</p>
      <h2>Search by project or category.</h2>
    </div>
    <p>Filter by curated security domains, sort alphabetically, and share the URL to keep your filters. Every result links to the official project.</p>
  </div>

  <div id="kube-tools" class="mt-9">
    <form action="/tools" method="get" class="flex flex-wrap items-end gap-3 mb-6">
      <div class="flex-1">
        <label for="server-tool-query" class="block mb-2 font-semibold">Search security tools</label>
        <input id="server-tool-query" name="q" value={@query} type="search" class="w-full rounded-lg border p-3 text-slate-900" />
      </div>
      <input type="hidden" name="category" value={@category} />
      <input type="hidden" name="sort" value={@sort} />
      <button type="submit" class="kube-button">Search</button>
    </form>
    <p class="mb-4">{@result.total} matching tools · Page {@result.page} of {@result.page_count}</p>
    <p :if={@result.total == 0}>No matching security tools. Try another search.</p>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <li :for={tool <- @result.tools} class="rounded-xl border p-5">
        <h3 class="font-bold text-lg">
          <a href={tool["link"]} target="_blank" rel="noreferrer">{tool["title"]}</a>
        </h3>
        <p class="mt-2 text-sm">{tool["description"]}</p>
      </li>
    </ul>
    <nav :if={@result.page_count > 1} aria-label="Tool results pagination" class="flex gap-6 mt-6">
      <a :if={@result.page > 1} href={page_url(@query, @category, @sort, @result.page - 1)}>Previous page</a>
      <a :if={@result.page < @result.page_count} href={page_url(@query, @category, @sort, @result.page + 1)}>Next page</a>
    </nav>
  </div>

  <noscript>
    <div class="kube-tool-empty py-12 text-center">
      <p>JavaScript adds instant filtering. The form above works on the Phoenix server; on GitHub Pages, <a href="https://github.com/CloudSecCorner/cloudseccorner.github.io/blob/main/priv/data/security-entries.json" target="_blank" rel="noreferrer">browse the full dataset on GitHub</a> without JavaScript.</p>
    </div>
  </noscript>

  <script :if={!CloudSecurityCorner.Frontend.enabled?()} type="module" src="/tools.js"></script>
</section>

<section class="kube-contribute">
  <div class="mx-auto max-w-screen-xl px-4 py-12 sm:px-6 lg:px-10 lg:py-14">
    <div class="kube-contribute-copy">
      <p class="kube-label">Grow the directory</p>
      <h2>Know a tool the security community should discover?</h2>
      <p>Recommend a maintained project, improve a description, or help keep links and categories useful for people evaluating their cloud &amp; agentic stack.</p>
    </div>
    <div class="kube-contribute-actions">
      <a class="kube-contribute-primary" href="https://github.com/CloudSecCorner/cloudseccorner.github.io/blob/main/CONTRIBUTING.md" target="_blank" rel="noreferrer">Contribution guide ↗</a>
      <a href="https://github.com/CloudSecCorner/cloudseccorner.github.io/issues/new/choose" target="_blank" rel="noreferrer">Recommend a tool ↗</a>
    </div>
  </div>
</section>

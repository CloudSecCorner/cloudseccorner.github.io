<header class="kube-library-header">
  <div class="kube-library-container">
    <p class="kube-label">Reviewed 2026-11-06</p>
    <h1>Hands-on Security Labs</h1>
    <p class="kube-library-intro">Executable exercises for agent authorization, workload identity, RAG data boundaries, artifact verification, container policy, and network exposure. Each lab includes prerequisites, failure cases, evidence, and cleanup.</p>
    <div class="kube-library-links"><a href="/blog/">Read the current field notes →</a></div>
  </div>
</header>

<section id="lab-library" class="kube-library-container kube-library-section">
  <form action="/labs" method="get" class="flex flex-wrap gap-4 items-end mb-8">
    <div class="flex-1">
      <label for="lab-query" class="block mb-2 font-semibold">Search labs</label>
      <input id="lab-query" type="search" name="q" value={@query} class="w-full rounded-lg border p-3 text-slate-900" />
    </div>
    <div>
      <label for="lab-category" class="block mb-2 font-semibold">Category</label>
      <select id="lab-category" name="category" class="rounded-lg border p-3 text-slate-900">
        <option value="">All categories</option>
        <option :for={category <- @categories} value={category} selected={@category == category}>{category}</option>
      </select>
    </div>
    <button type="submit" class="kube-button">Search</button>
  </form>
  <p class="kube-library-count">{length(@labs)} labs to explore</p>
  <p :if={@labs == []}>No labs match that search. Try another query.</p>
  <div class="kube-labs-grid">
    <article :for={lab <- @labs} class="kube-lab-card">
      <p class="kube-label">{lab["category"]}</p>
      <h2><a href={"/labs/" <> lab["id"]}>{lab["title"]}</a></h2>
      <p>{lab["description"]}</p>
      <p>{lab["duration"]} · Reviewed <time datetime={lab["updated"]}>{lab["updated"]}</time></p>
      <div class="kube-lab-card-tags"><span :for={tag <- Enum.take(lab["tags"] || [], 3)}>{tag}</span></div>
      <a class="kube-lab-card-link" href={"/labs/" <> lab["id"]}>Open lab →</a>
      <a :if={lab["exercise"]} class="kube-lab-card-link" href={lab["exercise"]} download>Download exercise</a>
    </article>
  </div>
</section>

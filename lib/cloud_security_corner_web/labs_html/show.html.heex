<!-- Top Floating Reading Progress Bar -->
<div class="fixed top-0 left-0 right-0 h-1 bg-transparent z-50 pointer-events-none">
  <div id="reading-progress-bar" class="h-full bg-gradient-to-r from-purple-500 via-indigo-500 to-pink-500 transition-all duration-150 ease-out" style="width: 0%"></div>
</div>

<header class="kube-lab-reader-header w-full border-b border-slate-200 dark:border-[#26203b] bg-white dark:bg-[#130f1c]" id="reader-top">
  <div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <nav class="kube-lab-breadcrumb" aria-label="Breadcrumb">
      <a href="/labs/">Labs</a>
      <span aria-hidden="true">/</span>
      <span class="capitalize">{@lab["category"]}</span>
    </nav>
    <div class="flex flex-wrap items-center gap-3 mt-3 mb-2">
      <span class="kube-label !mb-0">Self-paced lab</span>
      <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-100 dark:bg-purple-900/50 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800/60">
        ⏱️ Self-Paced Track
      </span>
      <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-[#1f1b2e] text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-[#2b243f]">
        Production Grade
      </span>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2 mb-3">
      {@lab["title"]}
    </h1>
    <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base max-w-4xl leading-relaxed">
      {@lab["description"]}
    </p>
    <div class="kube-lab-reader-tags mt-4" aria-label="Lab topics">
      <span :for={tag <- @lab["tags"] || []}>{tag}</span>
    </div>
  </div>
</header>

<section class="kube-lab-steps border-b border-slate-200 dark:border-[#26203b] bg-slate-100/60 dark:bg-[#0f0c18]" id="reader-steps" aria-label="How to use this lab">
  <div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <ol>
      <li><span>1</span><div><strong>Read the concept</strong><small>Build the mental model first.</small></div></li>
      <li><span>2</span><div><strong>Try the commands</strong><small>Use a disposable sandbox.</small></div></li>
      <li><span>3</span><div><strong>Keep the notes</strong><small>Return when you need a refresher.</small></div></li>
    </ol>
  </div>
</section>

<!-- Ergonomic Reader Sticky Toolbar (Width, Font Size, Zen Mode) -->
<div class="sticky top-16 z-40 w-full border-b border-slate-200 dark:border-[#26203b] bg-white/95 dark:bg-[#130f1c]/95 backdrop-blur-md transition-all shadow-xs" id="reader-toolbar">
  <div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex flex-wrap items-center justify-between gap-3 text-xs">
    <!-- Left: Quick Breadcrumb / Zen Exit -->
    <div class="flex items-center gap-3">
      <a
        href="/labs/"
        id="reader-back-link"
        class="text-slate-600 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 font-semibold flex items-center gap-1"
      >
        ← All Labs
      </a>
      <span class="hidden sm:inline-block text-slate-300 dark:text-[#2e2646]">|</span>
      <span class="hidden md:inline font-medium text-slate-600 dark:text-slate-300 truncate max-w-xs xl:max-w-md">
        {@lab["title"]}
      </span>
    </div>

    <!-- Right: Controls (Scroll %, Width Measure, Font Size, Zen Focus) -->
    <div class="flex items-center gap-2 sm:gap-4 flex-wrap ml-auto">
      <!-- Scroll % -->
      <div class="hidden sm:flex items-center gap-1.5 font-mono text-[11px] text-slate-500 dark:text-slate-400">
        <span id="reading-percent-text">0% read</span>
      </div>

      <!-- Font Size Selector -->
      <div class="flex items-center rounded-lg border border-slate-200 dark:border-[#2b243f] p-0.5 bg-slate-100/70 dark:bg-[#1a1528]" id="font-size-group">
        <button
          type="button"
          id="btn-font-normal"
          title="Default Font (17px)"
          class="font-btn active px-2 py-0.5 rounded text-xs font-semibold bg-white dark:bg-[#2a223f] text-purple-700 dark:text-purple-300 shadow-xs cursor-pointer"
        >
          A
        </button>
        <button
          type="button"
          id="btn-font-large"
          title="Large Font (19px)"
          class="font-btn px-2 py-0.5 rounded text-xs font-bold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer"
        >
          A+
        </button>
        <button
          type="button"
          id="btn-font-xlarge"
          title="X-Large Font (21px)"
          class="font-btn px-2 py-0.5 rounded text-xs font-black text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer"
        >
          A++
        </button>
      </div>

      <!-- Width Mode Selector -->
      <div class="flex items-center rounded-lg border border-slate-200 dark:border-[#2b243f] p-0.5 bg-slate-100/70 dark:bg-[#1a1528]" id="width-mode-group">
        <button
          type="button"
          id="btn-width-reading"
          title="Optimal 75-80 char line length for deep reading"
          class="width-btn active px-2.5 py-0.5 rounded text-xs font-bold bg-white dark:bg-[#2a223f] text-purple-700 dark:text-purple-300 shadow-xs cursor-pointer"
        >
          Optimal
        </button>
        <button
          type="button"
          id="btn-width-full"
          title="Full 100% monitor width"
          class="width-btn px-2.5 py-0.5 rounded text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer"
        >
          Full Width
        </button>
      </div>

      <!-- Zen Focus Mode Button -->
      <button
        type="button"
        id="btn-zen-mode"
        title="Zen Focus Mode (Hide sidebar and distractions)"
        class="flex items-center gap-1 px-2.5 py-1 rounded-lg border text-xs font-medium bg-white dark:bg-[#1a1528] text-slate-700 dark:text-slate-300 border-slate-200 dark:border-[#2b243f] hover:bg-slate-50 dark:hover:bg-[#231c36] cursor-pointer"
      >
        <span id="zen-btn-label">🧘 Zen Mode</span>
      </button>
    </div>
  </div>
</div>

<article id="reader-article" class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
  <div id="reader-flex-container" class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-start">

    <!-- Left Column: Interactive Navigation & TOC -->
    <aside id="reader-aside" class="w-full lg:w-72 xl:w-80 shrink-0 lg:sticky lg:top-24 max-h-[calc(100vh-7rem)] lg:overflow-y-auto space-y-6 order-2 lg:order-1">
      <div class="rounded-xl border border-slate-200 dark:border-[#26203b] bg-white dark:bg-[#130f1c] p-4 shadow-xs">
        <a href="/labs/" class="flex items-center gap-2 text-xs font-bold text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 transition">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to All Labs
        </a>

        <div class="mt-3 pt-3 border-t border-slate-100 dark:border-[#201a30] flex flex-col gap-2">
          <button
            id="copy-link-btn"
            type="button"
            class="flex items-center justify-between px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-50 dark:bg-[#1a1528] text-slate-700 dark:text-slate-300 hover:bg-purple-50 dark:hover:bg-purple-950/40 border border-slate-200 dark:border-[#26203b] transition cursor-pointer"
          >
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
              <span id="copy-link-text">Copy Lab Link</span>
            </span>
          </button>

          <a
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-300 transition"
            href={"https://github.com/CloudSecCorner/cloudseccorner.github.io/blob/main/priv/static#{@lab["path"]}"}
            target="_blank"
            rel="noreferrer"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            Edit on GitHub →
          </a>
        </div>
      </div>

      <!-- Dynamic Table of Contents Container -->
      <nav id="lab-toc-container" class="hidden rounded-xl border border-slate-200 dark:border-[#26203b] bg-white dark:bg-[#130f1c] p-4 shadow-xs" aria-label="Table of Contents">
        <div class="flex items-center gap-2 mb-3 pb-2 border-b border-slate-100 dark:border-[#201a30]">
          <span class="w-2 h-2 rounded-full bg-purple-500"></span>
          <span class="text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            On This Page
          </span>
          <span id="toc-count" class="ml-auto text-[10px] font-mono text-slate-400 dark:text-slate-500"></span>
        </div>
        <div id="lab-toc-list" class="space-y-1 max-h-[50vh] overflow-y-auto pr-1 text-xs"></div>
      </nav>

      <div class="px-2">
        <a
          class="text-xs text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-300 transition flex items-center gap-1.5"
          href="https://github.com/CloudSecCorner/cloudseccorner.github.io/blob/main/CONTRIBUTING.md"
          target="_blank"
          rel="noreferrer"
        >
          <span>📖</span> Community contribution guide →
        </a>
      </div>
    </aside>

    <!-- Right Column: Lab Content with Ergonomic Reader Measure -->
    <div id="reader-main" class="flex-1 min-w-0 w-full order-1 lg:order-2">
      <div id="lab-prose-container" class="reader-measure-reading">
        <div class="rounded-xl border border-purple-200 dark:border-purple-900/60 bg-purple-50/70 dark:bg-[#1a1429] p-4 sm:p-5 mb-8 text-sm leading-relaxed text-slate-700 dark:text-slate-300 shadow-xs">
          <strong class="text-slate-900 dark:text-white font-bold block mb-1">
            🛡️ Production Safety Protocol:
          </strong>
          Review all commands, security policies, and network sweeps before executing. Never run intrusive scans or automated agents against production VPCs without verified written authorization and change-window approval.
        </div>

        <div id="lab-markdown-body" class="kube-markdown w-full text-base leading-relaxed bg-white dark:bg-[#130f1c] rounded-2xl border border-slate-200 dark:border-[#26203b] p-6 sm:p-10 shadow-sm">
          {raw(@content_html)}
        </div>

        <footer class="mt-12 pt-6 border-t border-slate-200 dark:border-[#26203b] flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <p class="text-xs uppercase font-extrabold tracking-wider text-slate-500 dark:text-slate-400">
              Ready for another topic?
            </p>
            <a href="/labs/" class="text-sm font-bold text-purple-600 dark:text-purple-400 hover:underline mt-1 inline-block">
              Browse full cloud AI security curriculum →
            </a>
          </div>
          <a href="#reader-top" class="px-4 py-2 rounded-lg text-xs font-bold text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-[#1f1b2e] hover:bg-slate-200 dark:hover:bg-[#2b243f] transition border border-slate-200 dark:border-[#2b243f]">
            Back to top ↑
          </a>
        </footer>
      </div>
    </div>
  </div>
</article>

<script src="/assets/pele.global.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // 1. Copy link button handler
    var copyBtn = document.getElementById("copy-link-btn");
    var copyText = document.getElementById("copy-link-text");
    if (copyBtn && copyText) {
      copyBtn.addEventListener("click", function () {
        navigator.clipboard.writeText(window.location.href).then(function () {
          copyText.textContent = "Link Copied! ✓";
          setTimeout(function () {
            copyText.textContent = "Copy Lab Link";
          }, 2000);
        });
      });
    }

    // 2. Dynamic Table of Contents generation
    var markdownEl = document.querySelector(".kube-markdown");
    var tocContainer = document.getElementById("lab-toc-container");
    var tocList = document.getElementById("lab-toc-list");
    var tocCount = document.getElementById("toc-count");

    if (markdownEl && tocContainer && tocList) {
      var headings = markdownEl.querySelectorAll("h2, h3");
      if (headings.length > 0) {
        tocContainer.classList.remove("hidden");
        if (tocCount) tocCount.textContent = headings.length + " sections";

        headings.forEach(function (h, idx) {
          var text = h.textContent.trim().replace(/^#+\s*/, "");
          var slug = h.id || text.toLowerCase().replace(/[^\w\s-]/g, "").trim().replace(/\s+/g, "-") || ("section-" + idx);
          h.id = slug;
          h.classList.add("scroll-mt-24");

          var isH3 = h.tagName.toLowerCase() === "h3";
          var a = document.createElement("a");
          a.href = "#" + slug;
          a.className = "toc-link block py-1.5 px-2.5 rounded-md transition text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-[#1c172b] hover:text-slate-900 dark:hover:text-white truncate " +
            (isH3 ? "pl-5 text-slate-500 dark:text-slate-400" : "font-medium");
          a.textContent = text;
          a.addEventListener("click", function (e) {
            e.preventDefault();
            var target = document.getElementById(slug);
            if (target) {
              var y = target.getBoundingClientRect().top + window.pageYOffset - 90;
              window.scrollTo({ top: y, behavior: "smooth" });
            }
          });
          tocList.appendChild(a);
        });

        // Scroll spy
        if ("IntersectionObserver" in window) {
          var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                var id = entry.target.id;
                var links = tocList.querySelectorAll(".toc-link");
                links.forEach(function (link) {
                  if (link.getAttribute("href") === "#" + id) {
                    link.classList.add("bg-purple-100", "dark:bg-purple-900/50", "text-purple-900", "dark:text-purple-200", "font-bold", "border-l-2", "border-purple-600", "dark:border-purple-400");
                  } else {
                    link.classList.remove("bg-purple-100", "dark:bg-purple-900/50", "text-purple-900", "dark:text-purple-200", "font-bold", "border-l-2", "border-purple-600", "dark:border-purple-400");
                  }
                });
              }
            });
          }, { rootMargin: "-80px 0% -65% 0%", threshold: 0 });

          headings.forEach(function (h) { observer.observe(h); });
        }
      }
    }

    // 3. Pele Vector Architecture and Diagram Rendering
    if (typeof pele !== "undefined" && pele.render) {
      var codeBlocks = document.querySelectorAll("pre code");
      codeBlocks.forEach(function (el) {
        var className = el.className || "";
        var isMermaid = className.indexOf("mermaid") !== -1 || className.indexOf("pele") !== -1 || className.indexOf("architecture") !== -1;
        var text = el.textContent || "";
        var trimmed = text.trim();

        var isDiagram = isMermaid ||
          trimmed.indexOf("flowchart") === 0 ||
          trimmed.indexOf("graph") === 0 ||
          trimmed.indexOf("sequenceDiagram") === 0 ||
          trimmed.indexOf("stateDiagram") === 0 ||
          trimmed.indexOf("erDiagram") === 0 ||
          trimmed.indexOf("architecture") === 0;

        if (isDiagram) {
          try {
            var result = pele.render(trimmed);
            if (result && result.svg) {
              var container = document.createElement("div");
              container.className = "my-8 w-full rounded-2xl border border-slate-200/90 dark:border-[#2e2747] bg-white dark:bg-[#130f1c] shadow-md overflow-hidden";
              container.innerHTML =
                '<div class="flex items-center justify-between px-5 py-3 bg-slate-50 dark:bg-[#1a1528] border-b border-slate-200 dark:border-[#26203b] text-xs font-semibold text-slate-700 dark:text-slate-300">' +
                  '<div class="flex items-center gap-2.5">' +
                    '<span class="w-2.5 h-2.5 rounded-full bg-purple-500 inline-block animate-pulse"></span>' +
                    '<span class="font-mono text-xs uppercase tracking-wider text-purple-700 dark:text-purple-300 font-bold">Pele Architecture Vector Topology</span>' +
                  '</div>' +
                  '<span class="text-[11px] uppercase font-bold tracking-wider px-2.5 py-0.5 rounded-full bg-purple-100 dark:bg-purple-900/60 text-purple-800 dark:text-purple-300 border border-purple-200 dark:border-purple-700/50">Interactive SVG</span>' +
                '</div>' +
                '<div class="blueprint-canvas p-6 sm:p-8 flex justify-center items-center overflow-x-auto min-h-[220px] w-full">' +
                  '<div class="pele-svg-container w-full max-w-full flex justify-center">' +
                    result.svg +
                  '</div>' +
                '</div>';

              var pre = el.closest("pre");
              if (pre && pre.parentNode) {
                pre.parentNode.replaceChild(container, pre);
              }
            }
          } catch (e) {
            console.warn("Pele render error in lab:", e);
          }
        }
      });
    }

    // 4. Add copy button to normal code blocks
    var normalPres = document.querySelectorAll(".kube-markdown pre");
    normalPres.forEach(function (pre) {
      if (pre.closest(".blueprint-canvas") || pre.querySelector("button")) return;
      pre.classList.add("relative", "group");

      var copyCodeBtn = document.createElement("button");
      copyCodeBtn.type = "button";
      copyCodeBtn.className = "absolute top-2.5 right-2.5 opacity-0 group-hover:opacity-100 px-2 py-1 rounded text-[11px] font-mono text-slate-300 hover:text-white bg-slate-800/90 hover:bg-slate-700 transition border border-slate-700/60 cursor-pointer";
      copyCodeBtn.textContent = "Copy";
      copyCodeBtn.addEventListener("click", function () {
        var code = pre.querySelector("code");
        var text = (code ? code.textContent : pre.textContent) || "";
        navigator.clipboard.writeText(text).then(function () {
          copyCodeBtn.textContent = "Copied! ✓";
          setTimeout(function () { copyCodeBtn.textContent = "Copy"; }, 2000);
        });
      });
      pre.appendChild(copyCodeBtn);
    });

    // 5. Scroll Progress Bar & Indicator
    var progressBar = document.getElementById("reading-progress-bar");
    var percentText = document.getElementById("reading-percent-text");
    function updateScrollProgress() {
      var totalHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (totalHeight > 0) {
        var progress = Math.min(100, Math.max(0, Math.round((window.pageYOffset / totalHeight) * 100)));
        if (progressBar) progressBar.style.width = progress + "%";
        if (percentText) percentText.textContent = progress + "% read";
      }
    }
    window.addEventListener("scroll", updateScrollProgress, { passive: true });
    updateScrollProgress();

    // 6. Font Size Switching
    var proseEl = document.getElementById("lab-prose-container");
    var markdownBodyEl = document.getElementById("lab-markdown-body");
    var btnFontNormal = document.getElementById("btn-font-normal");
    var btnFontLarge = document.getElementById("btn-font-large");
    var btnFontXlarge = document.getElementById("btn-font-xlarge");
    var fontButtons = [btnFontNormal, btnFontLarge, btnFontXlarge];

    function setFontSize(size) {
      if (!markdownBodyEl) return;
      markdownBodyEl.classList.remove("text-base", "text-lg", "text-xl");
      fontButtons.forEach(function (btn) {
        if (!btn) return;
        btn.classList.remove("bg-white", "dark:bg-[#2a223f]", "text-purple-700", "dark:text-purple-300", "shadow-xs");
        btn.classList.add("text-slate-600", "dark:text-slate-400");
      });

      if (size === "large") {
        markdownBodyEl.classList.add("text-lg");
        if (btnFontLarge) {
          btnFontLarge.classList.add("bg-white", "dark:bg-[#2a223f]", "text-purple-700", "dark:text-purple-300", "shadow-xs");
          btnFontLarge.classList.remove("text-slate-600", "dark:text-slate-400");
        }
      } else if (size === "xlarge") {
        markdownBodyEl.classList.add("text-xl");
        if (btnFontXlarge) {
          btnFontXlarge.classList.add("bg-white", "dark:bg-[#2a223f]", "text-purple-700", "dark:text-purple-300", "shadow-xs");
          btnFontXlarge.classList.remove("text-slate-600", "dark:text-slate-400");
        }
      } else {
        markdownBodyEl.classList.add("text-base");
        if (btnFontNormal) {
          btnFontNormal.classList.add("bg-white", "dark:bg-[#2a223f]", "text-purple-700", "dark:text-purple-300", "shadow-xs");
          btnFontNormal.classList.remove("text-slate-600", "dark:text-slate-400");
        }
      }
    }

    if (btnFontNormal) btnFontNormal.addEventListener("click", function () { setFontSize("normal"); });
    if (btnFontLarge) btnFontLarge.addEventListener("click", function () { setFontSize("large"); });
    if (btnFontXlarge) btnFontXlarge.addEventListener("click", function () { setFontSize("xlarge"); });

    // 7. Width Mode Switching (Optimal vs Full Width)
    var btnWidthReading = document.getElementById("btn-width-reading");
    var btnWidthFull = document.getElementById("btn-width-full");

    function setWidthMode(mode) {
      if (!proseEl) return;
      if (mode === "full") {
        proseEl.classList.remove("reader-measure-reading");
        proseEl.classList.add("reader-measure-full");
        if (btnWidthFull) {
          btnWidthFull.classList.add("bg-white", "dark:bg-[#2a223f]", "text-purple-700", "dark:text-purple-300", "shadow-xs", "font-bold");
          btnWidthFull.classList.remove("text-slate-600", "dark:text-slate-400", "font-medium");
        }
        if (btnWidthReading) {
          btnWidthReading.classList.remove("bg-white", "dark:bg-[#2a223f]", "text-purple-700", "dark:text-purple-300", "shadow-xs", "font-bold");
          btnWidthReading.classList.add("text-slate-600", "dark:text-slate-400", "font-medium");
        }
      } else {
        proseEl.classList.remove("reader-measure-full");
        proseEl.classList.add("reader-measure-reading");
        if (btnWidthReading) {
          btnWidthReading.classList.add("bg-white", "dark:bg-[#2a223f]", "text-purple-700", "dark:text-purple-300", "shadow-xs", "font-bold");
          btnWidthReading.classList.remove("text-slate-600", "dark:text-slate-400", "font-medium");
        }
        if (btnWidthFull) {
          btnWidthFull.classList.remove("bg-white", "dark:bg-[#2a223f]", "text-purple-700", "dark:text-purple-300", "shadow-xs", "font-bold");
          btnWidthFull.classList.add("text-slate-600", "dark:text-slate-400", "font-medium");
        }
      }
    }

    if (btnWidthReading) btnWidthReading.addEventListener("click", function () { setWidthMode("reading"); });
    if (btnWidthFull) btnWidthFull.addEventListener("click", function () { setWidthMode("full"); });

    // 8. Zen Focus Mode
    var btnZen = document.getElementById("btn-zen-mode");
    var zenLabel = document.getElementById("zen-btn-label");
    var readerHeader = document.getElementById("reader-top");
    var readerSteps = document.getElementById("reader-steps");
    var readerAside = document.getElementById("reader-aside");
    var readerArticle = document.getElementById("reader-article");
    var isZen = false;

    if (btnZen) {
      btnZen.addEventListener("click", function () {
        isZen = !isZen;
        if (isZen) {
          if (readerHeader) readerHeader.classList.add("hidden");
          if (readerSteps) readerSteps.classList.add("hidden");
          if (readerAside) readerAside.classList.add("hidden");
          if (readerArticle) {
            readerArticle.classList.remove("max-w-[1600px]");
            readerArticle.classList.add("max-w-4xl");
          }
          if (zenLabel) zenLabel.textContent = "✕ Exit Zen Mode";
          btnZen.classList.add("bg-purple-100", "dark:bg-purple-900/50", "text-purple-800", "dark:text-purple-200", "border-purple-300", "dark:border-purple-700");
          btnZen.classList.remove("bg-white", "dark:bg-[#1a1528]", "text-slate-700", "dark:text-slate-300");
        } else {
          if (readerHeader) readerHeader.classList.remove("hidden");
          if (readerSteps) readerSteps.classList.remove("hidden");
          if (readerAside) readerAside.classList.remove("hidden");
          if (readerArticle) {
            readerArticle.classList.add("max-w-[1600px]");
            readerArticle.classList.remove("max-w-4xl");
          }
          if (zenLabel) zenLabel.textContent = "🧘 Zen Mode";
          btnZen.classList.remove("bg-purple-100", "dark:bg-purple-900/50", "text-purple-800", "dark:text-purple-200", "border-purple-300", "dark:border-purple-700");
          btnZen.classList.add("bg-white", "dark:bg-[#1a1528]", "text-slate-700", "dark:text-slate-300");
        }
      });
    }
  });
</script>

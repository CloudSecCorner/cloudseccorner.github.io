<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={assigns[:description] || "Practical resources for securing AI agents and cloud infrastructure."} />
    <meta name="theme-color" content="#18131f" />
    <meta name="keywords" content="cloud security, AI agent security, agentic AI, LLM security, MCP security, zero trust, threat modeling, DevSecOps, security tools" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cloud Security Corner" />
    <meta property="og:title" content={assigns[:page_title] || "Cloud Security Corner"} />
    <meta property="og:description" content={assigns[:description] || "Practical resources for securing AI agents and cloud infrastructure."} />
    <meta property="og:url" content={"https://cloudsecuritycorner.com" <> @conn.request_path} />
    <meta property="og:image" content="https://cloudsecuritycorner.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <link rel="canonical" href={"https://cloudsecuritycorner.com" <> @conn.request_path} />
    <link rel="icon" href="/android-icon-192x192.png" type="image/png" />
    <link rel="stylesheet" href="/assets/app.css" />
    <script src="/assets/initialize-theme.js"></script>
    <script defer src="/site.js"></script>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={assigns[:page_title] || "Cloud Security Corner"} />
    <meta name="twitter:description" content={assigns[:description] || "Practical resources for securing AI agents and cloud infrastructure."} />
    <meta name="twitter:image" content="https://cloudsecuritycorner.com/og-image.png" />
    <title>{assigns[:page_title] || "Cloud Security Corner"} · Cloud Security Corner</title>
  </head>
  <body class="bg-white text-slate-900 dark:bg-[#18131f] dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-200">
    <a class="kube-skip-link" href="#main-content">Skip to content</a>

    <!-- Announcement Bar -->
    <aside id="pick-up" class="pick-up flex h-auto min-h-10 items-center justify-center border-b border-purple-500/30 bg-[#2d1b4e] py-2 px-4 text-center text-xs font-semibold text-purple-200">
      <div class="mx-auto flex max-w-screen-xl flex-wrap items-center justify-center gap-2">
        <span>Practical engineering guidance for AI agents and cloud systems</span>
        <span class="opacity-40">|</span>
        <a href="https://github.com/CloudSecCorner/cloudseccorner.github.io" target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 font-bold text-white underline decoration-purple-400 hover:text-purple-100">
          Star on GitHub ↗
        </a>
      </div>
    </aside>

    <!-- Site Header -->
    <header class="kube-site-header">
      <nav class="kube-header-inner" aria-label="Main navigation">
        <a href="/" class="kube-brand" aria-label="CloudSecCorner home">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500 via-purple-600 to-cyan-400 text-white shadow-md shadow-purple-500/25" aria-hidden="true">
            <svg class="h-6 w-6" viewBox="0 0 32 32" fill="none" stroke="currentColor">
              <path d="M16 3.5l10 4.2v7.1c0 6.2-3.9 11-10 13.7-6.1-2.7-10-7.5-10-13.7V7.7L16 3.5z" stroke-width="1.8" stroke-linejoin="round" />
              <circle cx="16" cy="11" r="2" fill="currentColor" stroke="none" />
              <circle cx="11" cy="18" r="1.7" fill="currentColor" stroke="none" />
              <circle cx="21" cy="18" r="1.7" fill="currentColor" stroke="none" />
              <path d="M16 13v2.5m-1.5 1L12.4 17.5m5.1-1l2.1 1" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </span>
          <div class="flex flex-col text-left leading-none">
            <span class="text-base font-extrabold tracking-tight text-slate-900 dark:text-white">
              CloudSec<span class="text-[#8b5cf6] dark:text-[#caa2f5]">Corner</span>
            </span>
            <span class="text-[10px] font-semibold tracking-wider text-purple dark:text-brand-purple-100 uppercase mt-1">
              Agentic &amp; Cloud Security
            </span>
          </div>
        </a>

        <div class="hidden xl:flex kube-nav-menu">
          <a href="/" class="kube-nav-link">Home</a>
          <a href="/aws-architectures" class="kube-nav-link inline-flex items-center gap-1.5">
            <span>AWS Architectures</span>
            <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono font-bold leading-none bg-amber-500/15 text-amber-500 dark:text-amber-300 border border-amber-500/30">1,000+</span>
          </a>
          <a href="/azure-architectures" class="kube-nav-link inline-flex items-center gap-1.5">
            <span>Azure Architectures</span>
            <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono font-bold leading-none bg-cyan-500/15 text-cyan-600 dark:text-cyan-300 border border-cyan-500/30">1,000+</span>
          </a>
          <a href="/gcp-architectures" class="kube-nav-link inline-flex items-center gap-1.5">
            <span>GCP Architectures</span>
            <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono font-bold leading-none bg-emerald-500/15 text-emerald-600 dark:text-emerald-300 border border-emerald-500/30">1,000+</span>
          </a>
          <a href="/kspm-architectures" class="kube-nav-link inline-flex items-center gap-1.5">
            <span>KSPM Kubernetes</span>
            <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono font-bold leading-none bg-blue-500/15 text-blue-600 dark:text-blue-300 border border-blue-500/30">1,000+</span>
          </a>
          <a href="/tools" class="kube-nav-link">Tools</a>
          <a href="/labs" class="kube-nav-link">Labs</a>
          <a href="/blog" class="kube-nav-link">Blog</a>
          <a href="/about" class="kube-nav-link">About</a>
        </div>

        <div class="hidden xl:flex items-center gap-3">
          <button id="theme-toggle" type="button" class="p-2 rounded-lg text-slate-500 dark:text-slate-300 hover:text-purple dark:hover:text-white transition" aria-label="Toggle theme">
            <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
            <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
          </button>
          <a href="https://github.com/CloudSecCorner/cloudseccorner.github.io" class="kube-header-github hidden sm:inline-flex" target="_blank" rel="noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>

        <!-- Mobile & Tablet Actions -->
        <div class="flex items-center gap-1.5 xl:hidden">
          <button id="theme-toggle-mobile" type="button" class="p-2 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-[#3d4449] transition min-h-[44px] min-w-[44px] flex items-center justify-center" aria-label="Toggle theme">
            <svg id="theme-toggle-mobile-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
            <svg id="theme-toggle-mobile-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
          </button>
          <button id="mobile-menu-toggle" type="button" class="p-2 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-[#3d4449] transition min-h-[44px] min-w-[44px] flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-purple-500/50" aria-expanded="false" aria-controls="mobile-nav-drawer" aria-label="Open menu">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <!-- Mobile Drawer Backdrop -->
    <div id="mobile-drawer-backdrop" class="kube-mobile-backdrop" aria-hidden="true"></div>

    <!-- Mobile Navigation Drawer -->
    <div id="mobile-nav-drawer" class="kube-mobile-drawer" role="dialog" aria-modal="true" aria-label="Navigation drawer">
      <div class="flex items-center justify-between px-5 py-4 border-b border-slate-200 dark:border-[#3d4449] bg-slate-50/80 dark:bg-[#1a1f26]/80 backdrop-blur-md">
        <a href="/" class="flex items-center gap-3 text-left leading-none">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500 via-purple-600 to-cyan-400 text-white shadow-md shadow-purple-500/25" aria-hidden="true">
            <svg class="h-5 w-5" viewBox="0 0 32 32" fill="none" stroke="currentColor">
              <path d="M16 3.5l10 4.2v7.1c0 6.2-3.9 11-10 13.7-6.1-2.7-10-7.5-10-13.7V7.7L16 3.5z" stroke-width="1.8" stroke-linejoin="round" />
              <circle cx="16" cy="11" r="2" fill="currentColor" stroke="none" />
              <circle cx="11" cy="18" r="1.7" fill="currentColor" stroke="none" />
              <circle cx="21" cy="18" r="1.7" fill="currentColor" stroke="none" />
              <path d="M16 13v2.5m-1.5 1L12.4 17.5m5.1-1l2.1 1" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </span>
          <div class="flex flex-col">
            <span class="text-slate-900 dark:text-white font-extrabold text-base tracking-tight">
              CloudSec<span class="text-[#8b5cf6]">Corner</span>
            </span>
            <span class="text-[9px] font-bold uppercase tracking-[0.16em] text-[#7c6f89] dark:text-[#caa2f5] mt-0.5">
              Cloud &amp; Agentic Security
            </span>
          </div>
        </a>
        <button id="mobile-drawer-close" type="button" class="p-2 rounded-lg text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white hover:bg-slate-200/60 dark:hover:bg-[#3d4449] transition min-h-[44px] min-w-[44px] flex items-center justify-center" aria-label="Close navigation drawer">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="kube-drawer-body space-y-6">
        <div>
          <div class="kube-drawer-group-title">Overview</div>
          <a href="/" class="kube-drawer-link">
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-purple-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
              <span>Home Hub</span>
            </div>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div>
          <div class="flex items-center justify-between pr-2">
            <span class="kube-drawer-group-title">Architectures (4,000+)</span>
            <span class="text-[10px] font-mono font-bold text-purple-600 dark:text-purple-400 bg-purple-500/10 px-2 py-0.5 rounded-full">Pele + OPA</span>
          </div>
          <div class="space-y-1.5 mt-1">
            <a href="/aws-architectures" class="kube-drawer-link">
              <div class="flex flex-col text-left py-0.5">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold">AWS Architectures</span>
                  <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono font-bold leading-none bg-amber-500/15 text-amber-500 dark:text-amber-300 border border-amber-500/30">1,000+</span>
                </div>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-normal mt-0.5">Well-Architected, IAM &amp; VPC Security</span>
              </div>
              <svg class="w-4 h-4 text-slate-400 shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/azure-architectures" class="kube-drawer-link">
              <div class="flex flex-col text-left py-0.5">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold">Azure Architectures</span>
                  <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono font-bold leading-none bg-cyan-500/15 text-cyan-600 dark:text-cyan-300 border border-cyan-500/30">1,000+</span>
                </div>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-normal mt-0.5">Entra ID, NSG &amp; Defender Security</span>
              </div>
              <svg class="w-4 h-4 text-slate-400 shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/gcp-architectures" class="kube-drawer-link">
              <div class="flex flex-col text-left py-0.5">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold">GCP Architectures</span>
                  <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono font-bold leading-none bg-emerald-500/15 text-emerald-600 dark:text-emerald-300 border border-emerald-500/30">1,000+</span>
                </div>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-normal mt-0.5">Workload Identity, VPC SC &amp; SCC</span>
              </div>
              <svg class="w-4 h-4 text-slate-400 shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/kspm-architectures" class="kube-drawer-link">
              <div class="flex flex-col text-left py-0.5">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold">KSPM Kubernetes</span>
                  <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono font-bold leading-none bg-blue-500/15 text-blue-600 dark:text-blue-300 border border-blue-500/30">1,000+</span>
                </div>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-normal mt-0.5">Pod &amp; Kind Hardening with Pele &amp; OPA</span>
              </div>
              <svg class="w-4 h-4 text-slate-400 shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <div>
          <div class="kube-drawer-group-title">Resources &amp; Labs</div>
          <div class="space-y-1 mt-1">
            <a href="/tools" class="kube-drawer-link">
              <div class="flex flex-col text-left py-0.5">
                <span class="text-sm font-semibold">Security Tools</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-normal mt-0.5">37,000+ Curated Open Source Tools</span>
              </div>
              <svg class="w-4 h-4 text-slate-400 shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/labs" class="kube-drawer-link">
              <div class="flex flex-col text-left py-0.5">
                <span class="text-sm font-semibold">Hands-on Labs</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-normal mt-0.5">Agentic AI &amp; Cloud Security Roadmaps</span>
              </div>
              <svg class="w-4 h-4 text-slate-400 shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/blog" class="kube-drawer-link">
              <div class="flex flex-col text-left py-0.5">
                <span class="text-sm font-semibold">Engineering Blog</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-normal mt-0.5">Architecture Teardowns &amp; Guides</span>
              </div>
              <svg class="w-4 h-4 text-slate-400 shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/about" class="kube-drawer-link">
              <div class="flex flex-col text-left py-0.5">
                <span class="text-sm font-semibold">About Mission</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-normal mt-0.5">Open source community &amp; contributors</span>
              </div>
              <svg class="w-4 h-4 text-slate-400 shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="p-4 border-t border-slate-200 dark:border-[#3d4449] bg-slate-50 dark:bg-[#1a1f26] space-y-3">
        <a href="https://github.com/CloudSecCorner/cloudseccorner.github.io" target="_blank" rel="noreferrer" class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-sm font-bold bg-[#22272e] text-white hover:bg-[#31373b] transition shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
          Star on GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Main Content -->
    <main id="main-content" class="flex-1">{@inner_content}</main>

    <!-- KubeDaily Footer -->
    <footer class="kube-footer">
      <div class="kube-footer-main">
        <div class="kube-footer-intro">
          <a class="kube-footer-wordmark group" href="/" aria-label="CloudSecCorner home">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500 via-purple-600 to-cyan-400 text-white shadow-md shadow-purple-500/25 group-hover:scale-105 transition-transform" aria-hidden="true">
              <svg class="h-6 w-6" viewBox="0 0 32 32" fill="none" stroke="currentColor">
                <path d="M16 3.5l10 4.2v7.1c0 6.2-3.9 11-10 13.7-6.1-2.7-10-7.5-10-13.7V7.7L16 3.5z" stroke-width="1.8" stroke-linejoin="round" />
                <circle cx="16" cy="11" r="2" fill="currentColor" stroke="none" />
                <circle cx="11" cy="18" r="1.7" fill="currentColor" stroke="none" />
                <circle cx="21" cy="18" r="1.7" fill="currentColor" stroke="none" />
                <path d="M16 13v2.5m-1.5 1L12.4 17.5m5.1-1l2.1 1" stroke-width="1.6" stroke-linecap="round" />
              </svg>
            </span>
            <div class="flex flex-col text-left leading-none">
              <span class="font-extrabold text-lg tracking-tight text-white">
                CloudSec<span class="text-[#caa2f5]">Corner</span>

            <span class="text-base sm:text-lg font-extrabold tracking-tight text-slate-900 dark:text-white whitespace-nowrap">
              CloudSec<span class="text-[#8b5cf6] dark:text-[#caa2f5]">Corner</span>
            </span>
            <span class="text-[9px] sm:text-[10px] font-semibold tracking-wider text-purple dark:text-brand-purple-100 uppercase mt-0.5 sm:mt-1 whitespace-nowrap">

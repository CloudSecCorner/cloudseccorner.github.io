  <body class="bg-white text-slate-900 dark:bg-[#18131f] dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-200">
    <a class="kube-skip-link" href="#main-content">Skip to content</a>

    <!-- Announcement Bar -->

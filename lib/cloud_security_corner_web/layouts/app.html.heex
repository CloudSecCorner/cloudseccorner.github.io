<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={assigns[:description] || "Practical resources for securing AI agents and cloud infrastructure."} />
    <meta name="theme-color" content="#18131f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cloud Security Corner" />
    <meta property="og:title" content={assigns[:page_title] || "Cloud Security Corner"} />
    <meta property="og:description" content={assigns[:description] || "Practical resources for securing AI agents and cloud infrastructure."} />
    <link rel="canonical" href={"https://cloudsecuritycorner.com" <> @conn.request_path} />
    <link rel="icon" href="/android-icon-192x192.png" type="image/png" />
    <link rel="stylesheet" href="/assets/app.css" />
    <script src="/assets/initialize-theme.js"></script>
    <title>{assigns[:page_title] || "Cloud Security Corner"} · Cloud Security Corner</title>
  </head>
  <body class="bg-white text-slate-900 dark:bg-[#18131f] dark:text-white min-h-screen flex flex-col font-sans transition-colors duration-200">
    <!-- Announcement Bar -->
    <aside id="pick-up" class="pick-up flex h-auto min-h-10 items-center justify-center border-b border-purple-500/30 bg-[#2d1b4e] py-2 px-4 text-center text-xs font-semibold text-purple-200">
      <div class="mx-auto flex max-w-screen-xl flex-wrap items-center justify-center gap-2">
        <span>Practical engineering guidance for AI agents and cloud systems</span>
        <span class="opacity-40">|</span>
        <a href="https://github.com/CloudSecCorner/cloudseccorner.github.io" target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 font-bold text-white underline decoration-purple-400 hover:text-purple-100">
          Star on GitHub ↗
        </a>
      </div>
    </aside>

    <!-- Site Header -->
    <header class="kube-site-header sticky top-0 z-40 w-full border-b border-slate-200/80 dark:border-[#3d4449] bg-white/90 dark:bg-[#18131f]/90 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-screen-xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-3 font-extrabold text-slate-900 dark:text-white">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-tr from-purple-600 to-indigo-500 text-white shadow-sm font-black text-sm">
            CSC
          </div>
          <div class="flex flex-col">
            <span class="text-base font-extrabold tracking-tight">CloudSecCorner</span>
            <span class="text-[10px] font-semibold tracking-wider text-purple-600 dark:text-purple-300 uppercase">Agentic AI &amp; Cloud Security</span>
          </div>
        </a>

        <nav class="kube-nav-menu hidden md:flex items-center gap-1 rounded-full border border-slate-200/80 dark:border-[#3d4449] bg-slate-100/80 dark:bg-[#22272e] p-1 text-xs font-bold">
          <a href="/" class={"kube-nav-link rounded-full px-4 py-1.5 transition " <> if(@conn.request_path == "/", do: "bg-purple text-white shadow-sm", else: "text-slate-700 dark:text-slate-300 hover:text-purple-600 dark:hover:text-white")}>Home</a>
          <a href="/tools" class={"kube-nav-link rounded-full px-4 py-1.5 transition " <> if(String.starts_with?(@conn.request_path, "/tools"), do: "bg-purple text-white shadow-sm", else: "text-slate-700 dark:text-slate-300 hover:text-purple-600 dark:hover:text-white")}>Tools</a>
          <a href="/labs" class={"kube-nav-link rounded-full px-4 py-1.5 transition " <> if(String.starts_with?(@conn.request_path, "/labs"), do: "bg-purple text-white shadow-sm", else: "text-slate-700 dark:text-slate-300 hover:text-purple-600 dark:hover:text-white")}>Labs</a>
          <a href="/blog" class={"kube-nav-link rounded-full px-4 py-1.5 transition " <> if(String.starts_with?(@conn.request_path, "/blog"), do: "bg-purple text-white shadow-sm", else: "text-slate-700 dark:text-slate-300 hover:text-purple-600 dark:hover:text-white")}>Blog</a>
          <a href="/about" class={"kube-nav-link rounded-full px-4 py-1.5 transition " <> if(@conn.request_path == "/about", do: "bg-purple text-white shadow-sm", else: "text-slate-700 dark:text-slate-300 hover:text-purple-600 dark:hover:text-white")}>About</a>
        </nav>

        <div class="flex items-center gap-3">
          <a href="https://github.com/CloudSecCorner/cloudseccorner.github.io" target="_blank" rel="noreferrer" class="kube-header-github hidden sm:inline-flex items-center gap-2 rounded-lg border border-slate-300 dark:border-[#3d4449] bg-slate-50 dark:bg-[#22272e] px-3.5 py-1.5 text-xs font-bold text-slate-800 dark:text-white hover:bg-slate-100 dark:hover:bg-[#2a3038] transition">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">{@inner_content}</main>

    <!-- KubeDaily Footer -->
    <footer class="kube-footer">
      <div class="kube-footer-main">
        <div class="kube-footer-intro">
          <a class="kube-footer-wordmark" href="/">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-tr from-purple-600 to-indigo-500 text-white font-black text-xs">
              CSC
            </div>
            <span class="font-extrabold text-sm text-slate-900">CloudSecCorner</span>
          </a>
          <p>Practical tools, hands-on learning, and architecture teardowns for securing AI agents and the cloud systems they access.</p>
          <a class="kube-footer-github" href="https://github.com/CloudSecCorner/cloudseccorner.github.io" target="_blank" rel="noreferrer">
            ★ Star on GitHub ↗
          </a>
        </div>

        <div>
          <h3 class="kube-footer-heading">Explore</h3>
          <nav>
            <a href="/tools">Security &amp; Agentic Tools</a>
            <a href="/labs">Hands-on Labs</a>
            <a href="/blog">Field Notes &amp; Blog</a>
            <a href="/about">About CloudSecCorner</a>
          </nav>
        </div>

        <div>
          <h3 class="kube-footer-heading">Learn</h3>
          <nav>
            <a href="/labs/Agentic-Cloud-Security">Agentic Cloud Security</a>
            <a href="/labs/Zero-Trust-Architecture">Zero-Trust Architecture</a>
            <a href="/labs/Threat-Modeling">Threat Modeling Guide</a>
            <a href="/labs/Security-Engineering-Fundamentals">Security Fundamentals</a>
          </nav>
        </div>

        <div>
          <h3 class="kube-footer-heading">Community</h3>
          <nav>
            <a href="https://github.com/CloudSecCorner" target="_blank" rel="noreferrer">GitHub Organization ↗</a>
            <a href="https://github.com/CloudSecCorner/cloudseccorner.github.io/blob/main/CONTRIBUTING.md" target="_blank" rel="noreferrer">Contribution Guide ↗</a>
            <a href="https://discord.gg/aUD4hkYYGt" target="_blank" rel="noreferrer">Discord Community ↗</a>
          </nav>
        </div>
      </div>

      <div class="border-t border-brand-gray-700/60 py-6 text-center text-xs text-brand-gray-400">
        <div class="mx-auto flex max-w-screen-xl flex-col sm:flex-row items-center justify-between px-4 sm:px-6 lg:px-8 gap-2">
          <p>© Cloud Security Corner · Open Source Apache 2.0</p>
          <p>Open knowledge. Safer systems. Built with Elixir &amp; Phoenix.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

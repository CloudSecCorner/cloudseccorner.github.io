<section class="page-hero page-hero-compact">
  <div class="container narrow">
    <a class="back-link" href="/labs">← All labs</a>
    <p class="eyebrow">{@lab["category"]}</p>
    <h1>{@lab["title"]}</h1>
    <p>{@lab["description"]}</p>
    <div class="tag-list"><span :for={tag <- @lab["tags"] || []} class="tag">{tag}</span></div>
  </div>
</section>
<section class="section">
  <article class="container narrow prose markdown-content">{raw(@content_html)}</article>
</section>
